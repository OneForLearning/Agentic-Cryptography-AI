    "warning": "warning",
    "pitfall": "pitfall",
    "method": "method",
    "wex": "example",
    "exers": "exercise_set",
    "proof": "proof",
    "subproof": "proof",
    "solution": "solution",
}

STATEMENT_TYPES = {
    "definition", "theorem", "proposition", "lemma", "corollary", "claim",
    "axiom", "notation", "remark", "example", "example_set", "problem",
    "exercise", "question", "warning", "pitfall", "method", "exercise_set",
}

PROOF_TYPES = {"proof", "solution"}

