    "definition": "definition",
    "theorem": "theorem",
    "proposition": "proposition",
    "lemma": "lemma",
    "corollary": "corollary",
    "claim": "claim",
    "axiom": "axiom",
    "notation": "notation",
    "remark": "remark",
    "remarks": "remark",
    "example": "example",
    "example*": "example",
    "examples": "example_set",
    "examples*": "example_set",
    "problem": "problem",
    "problem*": "problem",
