{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LivreCrypto LaTeX RAG chunk",
  "type": "object",
  "required": ["chunk_id", "document_id", "unit_id", "unit_type", "embedding_text", "latex", "content_hash"],
  "properties": {
    "chunk_id": {"type": "string"},
    "document_id": {"type": "string"},
    "unit_id": {"type": "string"},
    "unit_type": {"type": "string"},
    "title": {"type": ["string", "null"]},
    "label": {"type": ["string", "null"]},
    "section_path": {"type": "array", "items": {"type": "object"}},
    "proof_of": {"type": ["string", "null"]},
    "related_unit_ids": {"type": "array", "items": {"type": "string"}},
    "references": {"type": "array", "items": {"type": "string"}},
    "macros_used": {"type": "array", "items": {"type": "string"}},
    "macro_context": {"type": "array", "items": {"type": "object"}},
    "embedding_text": {"type": "string"},
    "latex": {"type": "string"},
    "content_hash": {"type": "string"}
  }
}
